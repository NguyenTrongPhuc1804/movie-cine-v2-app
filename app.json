{
  "expo": {
    "name": "Cineflexx",
    "slug": "moviecine-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-ultra.png",
    "scheme": "cineflexx",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#181616",
    "ios": {
      "bundleIdentifier": "com.cineflexx.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cineflexx.app",
      "adaptiveIcon": {
        "backgroundColor": "#181616",
        "foregroundImage": "./assets/images/logo-ultra.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo-ultra.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#181616",
          "image": "./assets/images/logo-ultra.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2698678d-1d8c-4ba8-83aa-84a2410b1af0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2698678d-1d8c-4ba8-83aa-84a2410b1af0"
    }
  }
}
