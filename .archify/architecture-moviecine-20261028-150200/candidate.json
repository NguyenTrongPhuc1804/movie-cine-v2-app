  "cards": [
    {
      "dot": "cyan",
      "title": "Tầng dữ liệu",
      "items": [
        "lib/api.ts gọi fetch tới API_DOMAIN, mặc định https://vsmov.com/api",
        "Cache RAM giữ Promise theo path: phim mới 5 phút, chi tiết 1 giờ, thể loại và quốc gia 1 ngày",
        "Lỗi thì xoá cache để lần sau gọi lại; 404 trả null để màn hình hiện \"Không tìm thấy phim\"",
        "movieAdapter chuẩn hoá JSON gốc sang types/movie.ts nên đổi nguồn phim chỉ sửa một chỗ"
      ]
    },
    {
      "dot": "emerald",
      "title": "Lưu trên máy",
      "items": [
        "AsyncStorage hai key: cineflexx-history và cineflexx-favorites",
        "Lịch sử giữ tối đa 20 phim, xem lại một phim thì đưa lên đầu chứ không thêm dòng",
        "useSyncExternalStore phát lại cho UI mỗi lần dữ liệu đổi, không cần backend"
      ]
    },
    {
      "dot": "rose",
      "title": "Phát phim",
      "items": [
        "WebView nhúng link_embed của server và tập đang chọn trong query ?server=&tap=",
        "allowNavigation chỉ cho top frame ở đúng origin với link phim, chặn quảng cáo tự chuyển trang",
        "Rời màn hình thì WebView bị huỷ nên video tự dừng"
      ]
    },
    {
      "dot": "amber",
      "title": "Điều hướng và phát hành",
      "items": [
        "Expo Router file-based: (tabs) cho bốn tab, Stack cho chi tiết phim và màn xem phim",
        "expo-updates cấu hình OTA, runtimeVersion theo appVersion",
        "EAS profile development / preview / production"
      ]
    }
  ]
